# Copy to .env next to compose.yaml for anything beyond local development.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
ALPHA_SECRET=
BETA_SECRET=
PAYMENTS_SECRET=
FAKE_CONTROL_TOKEN=

# Optional
# TELEGRAM_BOT_TOKEN=          # turns on Telegram initData auth for user endpoints
# PROVIDER_TIMEOUT=60          # watchdog, seconds
# FAKE_DEFAULT_BEHAVIOUR={"fail_rate": 0.2, "delay_min": 2, "delay_max": 20}
# APP_BIND=127.0.0.1           # where the published port listens
# APP_PORT=8000
